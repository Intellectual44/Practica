<Window x:Class="PrintingHouse.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Типография — вход" Width="516" Height="490" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" AutomationProperties.AutomationId="LoginWindow">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#132547" Padding="35,24,35,20">
      <Grid>
        <StackPanel>
          <TextBlock Text="Типография" Foreground="White" FontWeight="SemiBold" FontSize="30"/>
          <TextBlock Text="Заказы и производство тиражей" Foreground="#D7E4FF" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Rectangle Width="10" Height="38" Fill="#54C4E4" Margin="0,0,5,0"/>
          <Rectangle Width="10" Height="38" Fill="#F77EAE" Margin="0,0,5,0"/>
          <Rectangle Width="10" Height="38" Fill="#F7B859"/>
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel Margin="35,18,35,10">
      <TextBlock Text="Вход сотрудника" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,9"/>
      <Label Content="_Логин" Target="{Binding ElementName=Login}" Padding="0,5"/>
      <TextBox x:Name="Login" AutomationProperties.AutomationId="LoginInput" MaxLength="80"
               Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>
      <Label Content="_Пароль" Target="{Binding ElementName=Password}" Padding="0,10,0,5"/>
      <PasswordBox x:Name="Password" AutomationProperties.AutomationId="PasswordInput" MaxLength="128"/>
      <Button x:Name="SignInButton" Content="_Войти" AutomationProperties.AutomationId="SignInButton"
              Command="{Binding SignIn}" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0,17,0,0"/>
      <TextBlock AutomationProperties.AutomationId="LoginMessage" Foreground="#A3263C" Text="{Binding Message}"
                 TextWrapping="Wrap" Margin="0,9,0,0"/>
    </StackPanel>
  </DockPanel>
</Window>
