<Window x:Class="PrintingHouse.Desktop.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Типография" Width="1220" Height="740" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" AutomationProperties.AutomationId="WorkspaceWindow">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#132547" Padding="24,13">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding SessionCaption}" VerticalAlignment="Center" Foreground="#D7E4FF"
                     Margin="0,0,17,0" AutomationProperties.AutomationId="SessionCaption"/>
          <Button Content="Выйти" Command="{Binding Logout}" AutomationProperties.AutomationId="LogoutButton"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Rectangle Width="5" Height="29" Fill="#54C4E4" Margin="0,0,4,0"/>
          <Rectangle Width="5" Height="29" Fill="#F77EAE" Margin="0,0,4,0"/>
          <Rectangle Width="5" Height="29" Fill="#F7B859" Margin="0,0,13,0"/>
          <TextBlock Text="Типография" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="#E4EDFA" Padding="23,8" MinHeight="36">
      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource Ink}"
                 AutomationProperties.AutomationId="WorkspaceMessage"/>
    </Border>
    <TabControl AutomationProperties.AutomationId="WorkspaceTabs" SelectedIndex="{Binding Tab}"
                TabStripPlacement="Left" ItemContainerStyle="{StaticResource SectionTab}">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="182"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="#172B51" Padding="16,19">
              <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="0"/>
            </Border>
            <Border Grid.Column="1" Padding="24,15,24,18" Background="{StaticResource Background}">
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
            </Border>
          </Grid>
        </ControlTemplate>
      </TabControl.Template>
      <TabItem Header="Заказы" AutomationProperties.AutomationId="OrdersTab">
        <DockPanel Margin="0,8,0,0">
          <TextBlock DockPanel.Dock="Top" Text="{Binding OrderHeading}" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Поиск" VerticalAlignment="Center" Margin="0,0,8,4"/>
            <TextBox AutomationProperties.AutomationId="OrderSearchInput" Width="234" Margin="0,0,8,4" ToolTip="Номер, продукция, параметры печати, макет, заказчик или телефон"
                     AutomationProperties.Name="Поиск по заказам" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}">
              <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding RefreshOrders}"/></TextBox.InputBindings>
            </TextBox>
            <TextBlock Text="Статус" VerticalAlignment="Center" Margin="4,0,8,4"/>
            <ComboBox AutomationProperties.AutomationId="OrderStatusFilter" Width="155" Margin="0,0,8,4" AutomationProperties.Name="Фильтр по статусу"
                      ItemsSource="{Binding Filters}" SelectedItem="{Binding SelectedFilter}" DisplayMemberPath="Name"/>
            <Button AutomationProperties.AutomationId="RefreshOrdersButton" Content="Обновить" Command="{Binding RefreshOrders}" Margin="0,0,8,4"/>
            <Button Content="Новый заказ" Command="{Binding NewOrder}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"
                    Visibility="{Binding IsStaff, Converter={StaticResource VisibleWhen}}" AutomationProperties.AutomationId="NewOrderButton"/>
          </WrapPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button AutomationProperties.AutomationId="DetailsButton" Content="Карточка" Command="{Binding Details}" Margin="0,0,8,4"/>
            <Button AutomationProperties.AutomationId="EditOrderButton" Content="Редактировать" Command="{Binding EditOrder}" Margin="0,0,8,4"
                    Visibility="{Binding IsStaff, Converter={StaticResource VisibleWhen}}"/>
            <Button AutomationProperties.AutomationId="TransitionButton" Content="Сменить статус" Command="{Binding Transition}" Margin="0,0,8,4"/>
            <StackPanel Orientation="Horizontal" Margin="8,0,0,4"
                        Visibility="{Binding IsStaff, Converter={StaticResource VisibleWhen}}">
              <TextBlock Text="Выгрузить" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Button AutomationProperties.AutomationId="ExportCSVButton" Content="CSV" Command="{Binding Export}" CommandParameter="csv" Margin="0,0,4,0"/>
              <Button AutomationProperties.AutomationId="ExportJSONButton" Content="JSON" Command="{Binding Export}" CommandParameter="json" Margin="0,0,4,0"/>
              <Button AutomationProperties.AutomationId="ExportXMLButton" Content="XML" Command="{Binding Export}" CommandParameter="xml"/>
            </StackPanel>
          </WrapPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="{Binding OrderCount}" Foreground="{StaticResource Muted}" Margin="0,10,0,0"
                     AutomationProperties.AutomationId="OrderCount"/>
          <Grid>
            <DataGrid ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}"
                      AutomationProperties.AutomationId="OrdersGrid">
              <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Order.Id}" Width="48"/>
                <DataGridTextColumn Header="Продукция" Binding="{Binding Order.Title}" Width="2*" MinWidth="132"/>
                <DataGridTextColumn Header="Тираж" Binding="{Binding Order.Quantity, StringFormat=N0}" Width="72"/>
                <DataGridTextColumn Header="Заказчик" Binding="{Binding Order.Customer}" Width="1.3*" MinWidth="105"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="126"/>
                <DataGridTextColumn Header="Печатник" Binding="{Binding Order.Printer, TargetNullValue=—}" Width="120"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount}" Width="115"/>
                <DataGridTextColumn Header="Выдача до" Binding="{Binding Due}" Width="100"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding EmptyOrders}" IsHitTestVisible="False" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Заказчики" AutomationProperties.AutomationId="CustomersTab"
               Visibility="{Binding IsStaff, Converter={StaticResource VisibleWhen}}">
        <DockPanel Margin="0,8,0,0">
          <TextBlock DockPanel.Dock="Top" Text="Справочник заказчиков" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button AutomationProperties.AutomationId="NewCustomerButton" Content="Добавить" Command="{Binding NewCustomer}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,4"/>
            <Button AutomationProperties.AutomationId="EditCustomerButton" Content="Редактировать" Command="{Binding EditCustomer}" Margin="0,0,8,4"/>
            <Button AutomationProperties.AutomationId="ImportButton" Content="Импорт CSV" Command="{Binding Import}" Margin="0,0,8,4"/>
            <Button AutomationProperties.AutomationId="RefreshCustomersButton" Content="Обновить" Command="{Binding RefreshCustomers}" Margin="0,0,8,4"/>
          </WrapPanel>
          <TextBlock DockPanel.Dock="Bottom" Text="CSV в UTF-8. Заголовок Name,Phone,Email. Поддерживаются запятая и точка с запятой."
                     Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
          <DataGrid AutomationProperties.AutomationId="CustomersGrid" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="60"/>
              <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="1.5*"/>
              <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*"/>
              <DataGridTextColumn Header="Эл. почта" Binding="{Binding Email}" Width="1.5*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Статистика" AutomationProperties.AutomationId="StatisticsTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,8,0,0">
            <DockPanel Margin="0,0,0,14">
              <Button AutomationProperties.AutomationId="RefreshStatisticsButton" DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshStatistics}"/>
              <TextBlock Text="Статистика заказов" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <WrapPanel Margin="0,0,0,12">
              <TextBlock Margin="0,0,23,7" Text="{Binding Statistics.Total, StringFormat='Всего {0}'}"/>
              <TextBlock Margin="0,0,23,7" Text="{Binding Statistics.Open, StringFormat='В работе {0}'}"/>
              <TextBlock Margin="0,0,23,7" Text="{Binding Statistics.Issued, StringFormat='Выдано {0}'}"/>
              <TextBlock Margin="0,0,23,7" Text="{Binding Statistics.Cancelled, StringFormat='Отменено {0}'}"/>
            </WrapPanel>
            <WrapPanel Margin="0,0,0,14">
              <TextBlock Margin="0,0,23,7" Text="{Binding Statistics.TotalAmount, StringFormat='Сумма всех заказов {0:N2} ₽'}"/>
              <TextBlock Margin="0,0,23,7" Text="{Binding Statistics.IssuedAmount, StringFormat='Сумма выданных {0:N2} ₽'}"/>
              <TextBlock Margin="0,0,23,7" Text="{Binding AverageDays, StringFormat='Средний срок до выдачи {0}'}"/>
            </WrapPanel>
            <DataGrid AutomationProperties.AutomationId="StatisticsGrid" ItemsSource="{Binding Statuses}" MaxWidth="560" HorizontalAlignment="Left" Width="435">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Статус" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Заказы" Binding="{Binding Count}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Пользователи" AutomationProperties.AutomationId="UsersTab"
               Visibility="{Binding IsAdmin, Converter={StaticResource VisibleWhen}}">
        <DockPanel Margin="0,8,0,0">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <Button AutomationProperties.AutomationId="RefreshUsersButton" DockPanel.Dock="Right" Content="Обновить" Command="{Binding RefreshUsers}"/>
            <TextBlock Text="Пользователи типографии" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
          </DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Добавить сотрудника" Command="{Binding NewUser}" Style="{StaticResource PrimaryButton}"
                    AutomationProperties.AutomationId="NewUserButton" Margin="0,0,8,4"/>
            <Button Content="{Binding UserAccessAction}" Command="{Binding ToggleUserAccess}"
                    AutomationProperties.AutomationId="UserAccessButton" Margin="0,0,8,4"/>
          </WrapPanel>
          <DataGrid AutomationProperties.AutomationId="UsersGrid" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Имя" Binding="{Binding User.DisplayName}" Width="*"/>
              <DataGridTextColumn Header="Логин" Binding="{Binding User.Login}" Width="*"/>
              <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="*"/>
              <DataGridTextColumn Header="Доступ" Binding="{Binding Access}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
